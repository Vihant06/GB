# =============================================================================
# RepoMind Environment Configuration (.env.example)
# Copy this file to .env and provide your actual API keys.
# Do NOT commit your actual .env file with secrets to source control.
# =============================================================================

# --- NVIDIA NIM API (Required for Nemotron LLM inference) ---
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here

# --- Target Repository Configuration ---
# Optional default repository in "owner/repo" format (can also be linked dynamically via the UI)
# REPOMIND_REPO=owner/repo
# Optional local clone path (defaults to ./data/repositories/requests)
# REPOMIND_REPO_PATH=./data/repositories/requests
# SQLite knowledge & rate-limit database path (defaults to ./data/repomind_knowledge.db)
# REPOMIND_DB_PATH=./data/repomind_knowledge.db

# --- GitHub Integration (Optional for Issues and Actions CI sync) ---
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
REPOMIND_SYNC_ON_STARTUP=true

# --- External Technical Documentation APIs (Optional / Feature-Flagged) ---
# Context7 REST API v3 for official library docs
CONTEXT7_API_KEY=ctx7_your_context7_api_key_here

# Exa Search API for technical web search
EXA_API_KEY=exa_your_exa_api_key_here

# Firecrawl API v2 for documentation crawl & scrape
FIRECRAWL_API_KEY=fc-your-firecrawl_api_key_here

# --- Server, Security & Rate Limiting ---
REPOMIND_DEV_MODE=false
REPOMIND_TRUST_PROXY=false
REPOMIND_IDENTITY_SALT=repomind_secure_random_salt_change_in_production
REPOMIND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- Frontend Configuration (for Vite) ---
VITE_BACKEND_URL=http://localhost:8000
